      "expected": [
        -0.5,
        2.799999952316284,
        5.400000095367432
      ]
    },
    "passed": true,
    "gating": true,
    "interpretation": "Direct numerical verification of sample weighting",
    "limitations": "Small deterministic tensors; end-to-end behavior tested separately"
  },
  {
    "test": "B_centralized_equivalence",
